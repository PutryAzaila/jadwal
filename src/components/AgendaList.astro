---
import SessionCard from './SessionCard.astro';
import { HARI, sesiPerHari } from '../data/schedule';
---

<div class="flex flex-col gap-8">
  {
    HARI.map((hari) => {
      const sesi = sesiPerHari(hari);
      return (
        <section data-hari-section={hari} aria-label={`Jadwal hari ${hari}`}>
          <div class="mb-3 flex items-baseline gap-3">
            <h2 class="font-display text-xl font-semibold tracking-tight text-plum">
              {hari}
            </h2>
            <span class="h-px flex-1 bg-plum/12 dark:bg-plum/25" aria-hidden="true" />
            <span class="text-[0.7rem] uppercase tracking-[0.16em] text-plum-soft">
              {sesi.length} sesi
            </span>
          </div>
          <div class="flex flex-col gap-3">
            {sesi.map((s, i) => (
              <SessionCard sesi={s} stagger={i} />
            ))}
          </div>
        </section>
      );
    })
  }
</div>
